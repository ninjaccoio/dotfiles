{
    // =========================
    // BAR
    // =========================
    "layer": "top",
    "position": "top",
    "height": 34,

    // Floating margins.
    // We'll tune these after seeing the bar on the laptop display.
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    // =========================
    // LAYOUT
    // =========================
    "modules-left": [
        "hyprland/workspaces",
        "custom/active-app"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "network",
        "bluetooth",
        "wireplumber",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    // =========================
    // WORKSPACES
    // =========================
    "hyprland/workspaces": {
        "format": "{name}"
    },

    "custom/active-app": {
        "exec": "~/.config/waybar/scripts/active-app.sh",
        "interval": 1,
        "tooltip": false
    },

    // =========================
    // CLOCK
    // =========================
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span><b>{}</b></span>",
                "days": "<span>{}</span>",
                "weeks": "<span>W{}</span>",
                "weekdays": "<span><b>{}</b></span>",
                "today": "<span><b><u>{}</u></b></span>"
            }
        }
    },

    // =========================
    // SYSTEM RESOURCES
    // =========================
    "cpu": {
        "format": "CPU {usage}%"
    },

    "memory": {
        "format": "RAM {percentage}%"
    },

    "temperature": {
        "format": "{temperatureC}°C"
    },

    // =========================
    // SYSTEM STATUS
    // =========================
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "Ethernet",
        "format-disconnected": "Offline",

        "tooltip": true,
        "on-click": "~/.config/rofi/scripts/wifi.sh"
    },

    "bluetooth": {
        "format": "BT",
        "format-disabled": "",
        "format-off": "BT off",
        "format-connected": "BT {num_connections}",
        "tooltip-format": "{controller_alias}\n{num_connections} connected"
    },

    "wireplumber": {
        "format": "VOL {volume}%",
        "format-muted": "Muted"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-full": "BAT {capacity}%"
    },

    "custom/notification": {
        "format": "󰂚",
        "tooltip": "Control Center",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": "Power menu",
        "on-click": "~/.config/rofi/scripts/powermenu.sh"
    }
}